# Copy to .env for LOCAL runs only (never commit real values). In GitHub use Settings > Secrets and variables > Actions.

# --- Telegram (required for live alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Global futures-volume ranking: three CoinMarketCap account API keys ---
# Add three distinct keys from three CMC accounts. Keys rotate automatically on quota/rate/auth errors.
CMC_API_KEY_1=
CMC_API_KEY_2=
CMC_API_KEY_3=

# --- Optional tuning (defaults shown) ---
# GLOBAL_RANKING_REFRESH_HOURS=4         # rebuild the ranking when the cache is at least this old
# GLOBAL_RANKING_MAX_AGE_HOURS=72        # a cache older than this is never used
# GLOBAL_MAX_EXCHANGES=40                # top-N derivatives exchanges aggregated
# GLOBAL_PAIRS_PER_EXCHANGE=1000         # top markets per exchange (CMC credits: 1 per 250 markets)
# GLOBAL_MAX_CREDITS_PER_REFRESH=400     # abort a refresh that would spend more CMC credits
# GLOBAL_VOLUME_CATEGORIES=all           # all | perpetual | futures
# GLOBAL_FILL_TO_N=true                  # walk down global futures ranking to target 500 eligible MEXC contracts
# CRYPTO_VERIFICATION=strict             # strict = CoinMarketCap must list the contract on MEXC | symbol
# TOP_N_SYMBOLS=500                      # top-N futures coins by global volume (then those on MEXC)
# MIN_MEXC_TURNOVER_USDT=1000000         # minimum MEXC 24h turnover per contract
# MAX_SPREAD_PCT=0.5                     # max bid/ask spread in % (only when bid/ask are available)
# EXTRA_EXCLUDED_BASES=                  # comma list of extra base tickers to exclude
# TP_EXTRA_RR=                           # optional extra TPs as multiples of risk, e.g. 1.5,2.5 (empty = original single TP)
# SCAN_GAP_SECONDS=0
# TELEGRAM_SUMMARY=false                 # true = one plain status message per run (pairs scanned, setup phases)
# STATE_PATH=state/sent_signals.json
# RANKING_CACHE_PATH=state/global_ranking.json
